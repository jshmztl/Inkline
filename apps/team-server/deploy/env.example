# ---- 部署配置（deploy.sh 会补全空白项）----
INKLINE_IMAGE=inkline-team-server:latest
INKLINE_PORT=8080

# bundled 模式（docker-compose.yml）：内置 PostgreSQL
POSTGRES_IMAGE=postgres:16-alpine
POSTGRES_DB=inkline_team
POSTGRES_USER=inkline
POSTGRES_PASSWORD=

# external 模式（docker-compose.app.yml）：连接已有 PostgreSQL，二选一填写
# DATABASE_URL=postgres://inkline:password@host.docker.internal:5432/inkline_team
# 外部数据库模式下 pg_dump 的绝对路径（默认自动查找 PATH 与 /opt/inkline-team/pgsql/bin）
# PG_DUMP_BIN=
# 外部数据库模式下若没有 pg_dump，可提供自定义备份命令（输出到 stdout）
# PG_DUMP_CMD=

# ---- 服务配置 ----
JWT_SECRET=
BIND_ADDR=0.0.0.0:8080
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
MAX_COMPRESSED_MB=10
MAX_UNCOMPRESSED_MB=50
DEFAULT_SNAPSHOT_RETENTION_DAYS=90
DEFAULT_AUDIT_RETENTION_DAYS=90
CLEANUP_INTERVAL_HOURS=24
CORS_ALLOWED_ORIGINS=http://tauri.localhost,https://tauri.localhost,tauri://localhost,http://localhost:1420,http://127.0.0.1:1420
MIN_CLIENT_VERSION=0.1.20
# 引导账号仅在账号不存在时创建，首次登录会强制修改口令
BOOTSTRAP_ACCOUNT=admin
BOOTSTRAP_PASSWORD=
